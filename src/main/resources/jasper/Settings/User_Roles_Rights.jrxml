    <subDataset name="User_role_list" uuid="9de23218-f992-465e-93b7-c7e14f56287c">
        <parameter name="DOC_KEY_POID" class="java.lang.String"/>
        <queryString>
            <![CDATA[select 'User List :'||STRING_AGG(GUSER.USER_NAME,',' ORDER BY GUSER.USER_NAME) userlist from GLOBAL_USERS_AUTH_ROLES_DTL DTL
INNER JOIN GLOBAL_USERS GUSER ON
DTL.USER_POID = GUSER.USER_POID
where user_role_poid =$P{DOC_KEY_POID}]]>
        </queryString>
        <field name="USERLIST" class="java.lang.String"/>
    </subDataset>
    <subDataset name="dataset1" uuid="06bfe86d-8cdb-4af3-ba41-39096c2e8b0b"/>
    <parameter name="LOGIN_GROUP_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_COMP_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_DIV_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_USER_POID" class="java.lang.String"/>
    <parameter name="DOC_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA["000-004"]]></defaultValueExpression>
    </parameter>
    <parameter name="DOC_KEY_POID" class="java.lang.String"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression>
            <![CDATA["\\\\ASGERPFS01.SHIPPINGBAHRAIN.COM\\ERP_Reports\\Reports\\"]]></defaultValueExpression>
    </parameter>
    <parameter name="USER_ROLE_POID" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_FOOTER" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUBREPORT1" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="BLACK_CHECK_MARK" class="java.lang.String"/>
    <queryString>
        <![CDATA[WITH RECURSIVE base AS (
      SELECT DISTINCT DM.MODULE_ID, MM.MODULE_ID::text MENU_ID, MM.MODULE_NAME MENU_NAME, 0 MENU_LEVEL, CAST(NULL AS text) MENU_GROUP, '' TASKFLOW_URL, ' ' DOC_TYPE, ' '
            VIEW_RIGHT,' ' CREATE_RIGHT,' ' EDIT_RIGHT,' ' DELETE_RIGHT,' ' PRINT_RIGHT,' ' EMAIL_RIGHT
      FROM  GLOBAL_MODULE_MASTER MM
      INNER JOIN GLOBAL_DOC_MASTER DM            ON MM.MODULE_ID = DM.MODULE_ID AND COALESCE(DM.ACTIVE,'N')  = 'Y'
      INNER JOIN GLOBAL_USER_ROLES_RIGHTS_DTL RD ON DM.DOC_ID    = RD.DOC_ID
      WHERE SUBSTR(COALESCE(RD.RIGHTS,'000000'),1,1)             = '1'
        AND RD.USER_ROLE_POID                                    = $P{DOC_KEY_POID}
      UNION ALL
      SELECT DISTINCT DM.MODULE_ID, (MM.MODULE_ID + DT.CONST_NO)::text MENU_ID, DT.CONST_NAME MENU_NAME, 1 MENU_LEVEL, MM.MODULE_ID::text MENU_GROUP, ''
            TASKFLOW_URL, ' ' DOC_TYPE, ' ' VIEW_RIGHT,' ' CREATE_RIGHT,' ' EDIT_RIGHT,' ' DELETE_RIGHT,' ' PRINT_RIGHT,' ' EMAIL_RIGHT
      FROM  GLOBAL_MODULE_MASTER MM
      INNER JOIN GLOBAL_DOC_MASTER DM            ON MM.MODULE_ID = DM.MODULE_ID AND COALESCE(DM.ACTIVE,'N')  = 'Y'
      INNER JOIN CONST_DOC_TYPES DT              ON DM.DOC_TYPE  = DT.CONST_NAME
      INNER JOIN GLOBAL_USER_ROLES_RIGHTS_DTL RD ON DM.DOC_ID    = RD.DOC_ID
      WHERE SUBSTR(COALESCE(RD.RIGHTS,'000000'),1,1)             = '1'
        AND RD.USER_ROLE_POID                                    = $P{DOC_KEY_POID}
      UNION ALL
      SELECT DISTINCT DM.MODULE_ID, DM.DOC_ID::text AS MENU_ID, DM.DOC_SHORT_NAME AS MENU_NAME, 2 MENU_LEVEL, (MM.MODULE_ID + DT.CONST_NO)::text AS
            MENU_GROUP, TASKFLOW_URL, DM.DOC_TYPE,
            CASE SUBSTR(RD.RIGHTS,1,1) WHEN '1' THEN 'Y' ELSE ' ' END VIEW_RIGHT,
            CASE SUBSTR(RD.RIGHTS,2,1) WHEN '1' THEN 'Y' ELSE ' ' END CREATE_RIGHT,
            CASE SUBSTR(RD.RIGHTS,3,1) WHEN '1' THEN 'Y' ELSE ' ' END EDIT_RIGHT,
            CASE SUBSTR(RD.RIGHTS,4,1) WHEN '1' THEN 'Y' ELSE ' ' END DELETE_RIGHT,
            CASE SUBSTR(RD.RIGHTS,5,1) WHEN '1' THEN 'Y' ELSE ' ' END PRINT_RIGHT,
            CASE SUBSTR(RD.RIGHTS,6,1) WHEN '1' THEN 'Y' ELSE ' ' END EMAIL_RIGHT
      FROM  GLOBAL_DOC_MASTER DM
      INNER JOIN GLOBAL_MODULE_MASTER MM         ON DM.MODULE_ID = MM.MODULE_ID
      INNER JOIN CONST_DOC_TYPES DT              ON DM.DOC_TYPE  = DT.CONST_NAME
      INNER JOIN GLOBAL_USER_ROLES_RIGHTS_DTL RD ON DM.DOC_ID    = RD.DOC_ID
      WHERE SUBSTR(COALESCE(RD.RIGHTS,'000000'),1,1)             = '1' AND COALESCE(DM.ACTIVE,'N')  = 'Y'
        AND RD.USER_ROLE_POID                                    = $P{DOC_KEY_POID}
), tree AS (
      SELECT b.*, 1 AS LEVEL, LPAD(b.MENU_ID, 20, '0') AS SORT_PATH
      FROM base b
      WHERE b.MENU_GROUP IS NULL
      UNION ALL
      SELECT c.*, t.LEVEL + 1, t.SORT_PATH || '.' || LPAD(c.MENU_ID, 20, '0')
      FROM base c
      INNER JOIN tree t ON c.MENU_GROUP = t.MENU_ID
      WHERE t.LEVEL + 1 <= 3
)
SELECT CASE WHEN MENU_LEVEL IN (0,1) THEN ' ' ELSE MENU_ID END MENU_ID,
       CASE WHEN LEVEL = 1 THEN MENU_NAME ELSE LPAD(' ', 2*LEVEL,'  ') || MENU_NAME END MENU_NAME,
       DOC_TYPE, VIEW_RIGHT, CREATE_RIGHT, EDIT_RIGHT, DELETE_RIGHT, PRINT_RIGHT, EMAIL_RIGHT, MENU_LEVEL,
       TO_CHAR(now(), 'dd-mon-yyyy hh.mi.ss AM') as DATE_TIME
FROM tree
ORDER BY SORT_PATH]]>
    </queryString>
    <field name="MENU_ID" class="java.lang.String"/>
    <field name="MENU_NAME" class="java.lang.String"/>
    <field name="DOC_TYPE" class="java.lang.String"/>
    <field name="VIEW_RIGHT" class="java.lang.String"/>
    <field name="CREATE_RIGHT" class="java.lang.String"/>
    <field name="EDIT_RIGHT" class="java.lang.String"/>
    <field name="DELETE_RIGHT" class="java.lang.String"/>
    <field name="PRINT_RIGHT" class="java.lang.String"/>
    <field name="EMAIL_RIGHT" class="java.lang.String"/>
    <field name="MENU_LEVEL" class="java.math.BigDecimal"/>
    <field name="DATE_TIME" class="java.lang.String"/>
    <variable name="variable1" class="java.lang.String">
        <variableExpression>
            <![CDATA["SELECT USER_ROLE_NAME FROM GLOBAL_USER_ROLES WHERE USER_ROLE_POID = $P{DOC_KEY_POID}"]]></variableExpression>
    </variable>
    <variable name="variable2" class="java.lang.String">
        <variableExpression><![CDATA[$V{variable1}]]></variableExpression>
    </variable>
