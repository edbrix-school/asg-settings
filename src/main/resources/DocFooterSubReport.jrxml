<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="DocFooterSubReport" language="groovy" pageWidth="520" pageHeight="802" columnWidth="520"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
    <parameter name="LOGIN_COMP_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="DOC_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA["000-004"]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT COMPANY_POID, COMPANY_NAME, ADDRESS, LOGO_IMAGE FROM GLOBAL_COMPANY_MASTER WHERE COMPANY_POID = $P{LOGIN_COMP_POID}]]></queryString>
    <field name="COMPANY_POID" class="java.math.BigDecimal"/>
    <field name="COMPANY_NAME" class="java.lang.String"/>
    <field name="ADDRESS" class="java.lang.String"/>
    <field name="LOGO_IMAGE" class="java.awt.Image"/>
    <title>
        <band height="20">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="522" height="18" forecolor="#000000"
                               backcolor="#FFFFFF"/>
                <textField pattern="EEEEE dd MMMMM yyyy">
                    <reportElement x="0" y="4" width="138" height="14" forecolor="#999999"/>
                    <textElement verticalAlignment="Middle">
                        <font size="8" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["ISO : " +$P{DOC_ID}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="155" y="4" width="337" height="14" forecolor="#999999"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font size="7" isBold="true"/>
                    </textElement>
                    <text><![CDATA[This is a computer-generated document and it does not require a signature.]]></text>
                </staticText>
            </frame>
        </band>
    </title>
</jasperReport>